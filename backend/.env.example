# RoadSafe India API Environment Variables

PROJECT_NAME="RoadSafe India API"
API_V1_STR="/api"
SECRET_KEY="roadsafe_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# PostgreSQL Database Connection (Falls back to SQLite sqlite:///./roadsafe.db if not provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadsafe_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
